# 复制为服务器上的 .env 后填写真实值。不要提交真实 .env。
# QWB-002 之后机器人以数据库为准：这里的地址只在 data/qwbot.sqlite3 首次初始化时播种，
# 或者在页面上把某个机器人的地址清空后作为兜底。换群、加群直接在 /notifications 页面操作，
# 不需要改 .env，也不需要重启容器。
WECOM_WEBHOOK_URL_PROD=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-with-prod-key
WECOM_WEBHOOK_URL_TEST=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-with-test-key
WECOM_WEBHOOK_TARGET=prod

BOT_TITLE=贷款核算测试日报提醒
SYSTEM_DATE_FORMAT=%Y-%m-%d
TIMEZONE=Asia/Shanghai

PROGRESS_SOURCE_URL=
BATCH_PLAN_SOURCE_URL=
PROGRESS_DOC_URL=https://doc.weixin.qq.com/sheet/your-progress-doc
BATCH_REGISTER_DOC_URL=https://doc.weixin.qq.com/sheet/your-batch-register-doc
CASE_ASSIGNMENT_DOC_URL=https://doc.weixin.qq.com/sheet/your-case-assignment-doc
AGENDA_DOC_URL=https://doc.weixin.qq.com/sheet/your-agenda-doc

# 部署到服务器时不要使用 127.0.0.1，填写服务器 IP 或域名。
FRONTEND_URL=http://your-server-ip:5000
QWBOT_PORT=5000

# docker-compose 会覆盖为 /app/data/sample_status.json。
LOCAL_STATUS_FILE=data/sample_status.json
QWBOT_DB_PATH=data/qwbot.sqlite3

# ---------------------------------------------------------------------------
# P0 安全配置（SEC-01 / SEC-03）
# ---------------------------------------------------------------------------
# SEC-01：维护面板登录。未设置 QWBOT_WEB_PASSWORD 时，/notifications 和所有写操作路由会
# 直接拒绝（fail-closed），跑批计划首页仍可只读访问。用户名默认 admin。
# 口令请用足够随机的字符串；容器重启后未设置 QWBOT_SECRET_KEY 时会重新生成会话密钥，
# 所有人需要重新登录，这是预期行为。
QWBOT_WEB_USERNAME=admin
QWBOT_WEB_PASSWORD=replace-with-a-random-panel-password
# 会话签名密钥。生产环境建议固定一个随机值（例如 `python -c "import secrets;print(secrets.token_hex(32))"`）。
QWBOT_SECRET_KEY=
# HTTPS/反向代理终结 TLS 的部署设为 1，会话 Cookie 才带 Secure 属性；本地 HTTP 访问请保持为空。
QWBOT_SECURE_COOKIES=

# SEC-03：webhook 主机白名单。默认只允许企业微信官方域名 qyapi.weixin.qq.com，
# 内网/回环/link-local 地址一律拒绝。确需其他主机（自建通知网关等）时在此追加，逗号分隔。
QWBOT_ALLOWED_WEBHOOK_HOSTS=
# 生产环境请保持为空（禁止把 webhook 指向本机或内网地址）。
QWBOT_ALLOW_INSECURE_LOCAL_WEBHOOKS=
